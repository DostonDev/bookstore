# Server
PORT=5000
NODE_ENV=development

# PostgreSQL / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pdf_bookstore?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=pdf-books
